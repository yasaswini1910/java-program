

interface I1{
    int x=100;
    int y=10;
    public void sum();
    public void sub();


}
class Caluculation implements I1{
    @Override
    public void sum()
    {
System.out.println("sum is"+(x+y));
    }
    @Override
    public void sub()
{
    System.out.println("subtraction is "+(x-y));
}


}
public class Interfaces {
    public static void main(String[] args) {
    Caluculation tv=new Caluculation();
    tv.sum();
    tv.sub();
    
        
    }
    
}
    