public class TenExceptionsDemo {

    public static void main(String[] args) {

        try {
            int x = 10 / 0;
        } catch (ArithmeticException e) {
            System.out.println("1. ArithmeticException");
        }

        try {
            String s = null;
            System.out.println(s.length());
        } catch (NullPointerException e) {
            System.out.println("2. NullPointerException");
        }

        try {
            int[] a = {1, 2, 3};
            System.out.println(a[5]);
        } catch (ArrayIndexOutOfBoundsException e) {
            System.out.println("3. ArrayIndexOutOfBoundsException");
        }

        try {
            String s = "Java";
            System.out.println(s.charAt(10));
        } catch (StringIndexOutOfBoundsException e) {
            System.out.println("4. StringIndexOutOfBoundsException");
        }

        try {
            int n = Integer.parseInt("Hello");
        } catch (NumberFormatException e) {
            System.out.println("5. NumberFormatException");
        }

        try {
            Object obj = Integer.valueOf(10);
            String s = (String) obj;
        } catch (ClassCastException e) {
            System.out.println("6. ClassCastException");
        }

        try {
            throw new IllegalArgumentException();
        } catch (IllegalArgumentException e) {
            System.out.println("7. IllegalArgumentException");
        }

        try {
            throw new IllegalStateException();
        } catch (IllegalStateException e) {
            System.out.println("8. IllegalStateException");
        }

        try {
            int[] arr = new int[-5];
        } catch (NegativeArraySizeException e) {
            System.out.println("9. NegativeArraySizeException");
        }

        try {
            throw new SecurityException();
        } catch (SecurityException e) {
            System.out.println("10. SecurityException");
        }
    }
}
